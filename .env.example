# Copy to .env.local and fill in. Never commit the filled version.

# ---------------------------------------------------------------------------
# Aggregator routing — REQUIRED for the app to execute a rotation.
#
# 1inch has supported Robinhood Chain (4663) since July 2026. A free key from
# portal.1inch.dev is enough; it is rate limited to about one request a second,
# which lib/oneinch/client.ts already serialises and caches around.
#
# Server-side only. Never prefix this with NEXT_PUBLIC_ — that would ship the
# key to every browser that loads the page.
# ---------------------------------------------------------------------------
ONEINCH_API_KEY=

# ---------------------------------------------------------------------------
# RPC. Optional: the app falls back to the chain's public endpoint, which works
# but which Robinhood's own docs do not recommend for production.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RPC_URL=

# ---------------------------------------------------------------------------
# WalletConnect project id. Optional; injected wallets work without it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WALLETCONNECT_ID=

# Pin the gateway if you know which one your key belongs to.
# scripts/check-routing.mjs prints the right value.
ONEINCH_BASE_URL=
